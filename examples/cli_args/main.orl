module app.cli_args

-- CLI with ori.args (not async tasks).
import ori.args as args
import ori.io as io
import ori.list as lists

struct Task
    title: string
    done: bool
end

marker(task: Task) -> string
    if task.done
        return "[x]"
    end
    return "[ ]"
end

done_count(tasks: list[Task]) -> int
    var total: int = 0
    for task in tasks
        if task.done
            total = total + 1
        end
    end
    return total
end

print_tasks(tasks: list[Task])
    for task in tasks
        const { title, done } = task
        const mark = if done then "[x]" else "[ ]"
        io.println(mark + " " + title)
    end
end

main()
    var tasks: list[Task] = lists.with_capacity(3)
    lists.push(tasks, Task { title: "write example", done: true })
    lists.push(tasks, Task { title: "run tests", done: false })
    lists.push(tasks, Task { title: "update docs", done: false })

    const command: string = args.get_or(1, "list")
    if command == "stats"
        io.print(f"{done_count(tasks)} of {lists.len(tasks)} done")
    else
        print_tasks(tasks)
    end
end
