module ori.fs

import ori.string as strings

public enum FsError
    NotFound
    PermissionDenied
    AlreadyExists
    InvalidPath
    Other(message: string)
end

public parse_fs_error(msg: string) -> FsError
    if strings.contains(msg, "No such file") or strings.contains(msg, "not found") or strings.contains(msg, "cannot find the file specified")
        return FsError.NotFound
    end
    if strings.contains(msg, "Permission denied") or strings.contains(msg, "access denied")
        return FsError.PermissionDenied
    end
    if strings.contains(msg, "already exists") or strings.contains(msg, "File exists")
        return FsError.AlreadyExists
    end
    if strings.contains(msg, "Invalid") or strings.contains(msg, "invalid")
        return FsError.InvalidPath
    end
    return FsError.Other(message: msg)
end

public try_read_text(path: string) -> result[string, FsError]
    match ori.fs.read_text(path)
        case ok(text):
            return ok(text)
        case err(msg):
            return err(parse_fs_error(msg))
    end
end

-- Public domain aliases (S3 culture 1.3 / 2.4)
public alias TextResult = result[string, string]
public alias BoolResult = result[bool, string]
public alias IoResult = result[void, string]

public read_text_or(path: string, fallback: string) -> string
    match ori.fs.read_text(path)
        case ok(text):
            return text
        case err(_):
            return fallback
    end
    return fallback
end

public write_text_result(path: string, content: string) -> TextResult
    return ori.fs.write_text(path, content)
end

public exists_result(path: string) -> BoolResult
    return ori.fs.exists(path)
end

public remove_file(path: string) -> IoResult
    return ori.fs.delete(path)
end

public move_path(from: string, to: string) -> IoResult
    return ori.fs.rename(from, to)
end

-- STDLIB-4 MVP (async-friendly FS): use Layer 1 `ori.fs.read_text_async` /
-- `write_text_async` (await-able). Do not re-export `task` here — importing
-- task from this module would pull concurrency into every `import ori.fs`
-- consumer (including C/debug of json helpers). Net uses
-- `connect_*_in_background` for Job-style offload. True non-blocking kernel
-- I/O remains STDLIB-4b.

