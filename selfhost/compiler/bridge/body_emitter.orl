module selfhost.compiler.bridge.body_emitter

import ori.list as lists
import ori.string as su
import selfhost.compiler.frontend.parse.parse_expr as exprs
import selfhost.compiler.frontend.parse.parse_stmt as stmts

-- The v1 bridge currently gives every variable and arithmetic expression the
-- type Int. Validate its actual supported subset before serializing anything.
public can_emit_int_expr(pool: exprs.ExprPool, id: int, local_names: list[string], func_names: list[string], func_ret_tys: list[string], func_param_counts: list[int]) -> bool
    if id < 0 or id >= lists.len(pool.kind_tags)
        return false
    end
    const tag = lists.get(pool.kind_tags, id)
    if tag == 1
        return true
    end
    if tag == 4
        const name = lists.get(pool.str_vals, id)
        var local_idx = 0
        while local_idx < lists.len(local_names)
            if name == lists.get(local_names, local_idx)
                return true
            end
            local_idx = local_idx + 1
        end
        return false
    end
    if tag == 5
        const op = lists.get(pool.str_vals, id)
        if op != "+" and op != "-" and op != "*" and op != "/"
            return false
        end
        return can_emit_int_expr(pool, lists.get(pool.left_ids, id), local_names, func_names, func_ret_tys, func_param_counts) and can_emit_int_expr(pool, lists.get(pool.right_ids, id), local_names, func_names, func_ret_tys, func_param_counts)
    end
    if tag == 6 and lists.get(pool.left_ids, id) == -1
        return can_emit_local_call(pool, id, func_names, func_ret_tys, func_param_counts, "int")
    end
    return false
end

can_emit_local_call(pool: exprs.ExprPool, id: int, func_names: list[string], func_ret_tys: list[string], func_param_counts: list[int], result_ty: string) -> bool
    const callee = lists.get(pool.str_vals, id)
    var i = 0
    while i < lists.len(func_names)
        if callee != "main" and callee != "println" and callee == lists.get(func_names, i)
            return lists.get(func_ret_tys, i) == result_ty and lists.get(func_param_counts, i) == 0
        end
        i = i + 1
    end
    return false
end

public can_emit_bool_expr(pool: exprs.ExprPool, id: int, local_names: list[string], func_names: list[string], func_ret_tys: list[string], func_param_counts: list[int]) -> bool
    if id < 0 or id >= lists.len(pool.kind_tags)
        return false
    end
    const tag = lists.get(pool.kind_tags, id)
    if tag == 3
        return true
    end
    if tag == 6 and lists.get(pool.left_ids, id) == -1
        return can_emit_local_call(pool, id, func_names, func_ret_tys, func_param_counts, "bool")
    end
    if tag == 5
        const op = lists.get(pool.str_vals, id)
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
            return can_emit_int_expr(pool, lists.get(pool.left_ids, id), local_names, func_names, func_ret_tys, func_param_counts) and can_emit_int_expr(pool, lists.get(pool.right_ids, id), local_names, func_names, func_ret_tys, func_param_counts)
        end
    end
    return false
end

public can_emit_print(pool: exprs.ExprPool, id: int, io_alias: string) -> bool
    if id < 0 or id >= lists.len(pool.kind_tags)
        return false
    end
    if lists.get(pool.kind_tags, id) != 6
        return false
    end
    const callee = lists.get(pool.str_vals, id)
    if io_alias == "" or callee != io_alias + ".println"
        return false
    end
    const arg_id = lists.get(pool.left_ids, id)
    if arg_id == -1
        return true
    end
    return arg_id >= 0 and arg_id < lists.len(pool.kind_tags) and lists.get(pool.kind_tags, arg_id) == 2
end

public can_emit_range(sp: stmts.StmtPool, pool: exprs.ExprPool, start_idx: int, end_idx: int, ret_ty: string, io_alias: string, func_names: list[string], func_ret_tys: list[string], func_param_counts: list[int]) -> bool
    if start_idx < 0 or end_idx > lists.len(sp.kind_tags) or start_idx > end_idx
        return false
    end
    const local_names: list[string] = []
    var i = start_idx
    while i < end_idx
        const tag = lists.get(sp.kind_tags, i)
        const expr_id = lists.get(sp.expr_ids, i)
        if tag == 1 or tag == 2
            if tag == 1
                if not can_emit_int_expr(pool, expr_id, local_names, func_names, func_ret_tys, func_param_counts)
                    return false
                end
                const target = lists.get(sp.target_names, i)
                var j = 0
                while j < lists.len(local_names)
                    if target == lists.get(local_names, j)
                        return false
                    end
                    j = j + 1
                end
                lists.push(local_names, target)
            elif ret_ty == "int"
                if not can_emit_int_expr(pool, expr_id, local_names, func_names, func_ret_tys, func_param_counts)
                    return false
                end
            elif ret_ty == "bool"
                if not can_emit_bool_expr(pool, expr_id, local_names, func_names, func_ret_tys, func_param_counts)
                    return false
                end
            else
                return false
            end
        elif tag == 3
            if not can_emit_print(pool, expr_id, io_alias) and not can_emit_int_expr(pool, expr_id, local_names, func_names, func_ret_tys, func_param_counts) and not can_emit_bool_expr(pool, expr_id, local_names, func_names, func_ret_tys, func_param_counts)
                return false
            end
        else
            -- Control flow and other statements need their full body, never
            -- the placeholder Return(IntLit(0)) previously emitted here.
            return false
        end
        i = i + 1
    end
    return true
end

public emit_expr_json(pool: exprs.ExprPool, id: int) -> string
    if id < 0 or id >= lists.len(pool.kind_tags)
        return "{\"IntLit\":0}"
    end

    const tag = lists.get(pool.kind_tags, id)
    if tag == 1 -- IntLit
        const raw = lists.get(pool.str_vals, id)
        return "{\"IntLit\":" + raw + "}"
    elif tag == 2 -- StrLit
        const val = sanitize_json_str(lists.get(pool.str_vals, id))
        return "{\"StrLit\":\"" + val + "\"}"
    elif tag == 3 -- BoolLit
        const val = lists.get(pool.str_vals, id)
        return "{\"BoolLit\":" + val + "}"
    elif tag == 4 -- Var / Ident
        const name = lists.get(pool.str_vals, id)
        return "{\"Var\":\"" + name + "\"}"
    elif tag == 5 -- Binary
        const left_id = lists.get(pool.left_ids, id)
        const right_id = lists.get(pool.right_ids, id)
        const op_str = lists.get(pool.str_vals, id)
        const left_json = emit_expr_json(pool, left_id)
        const right_json = emit_expr_json(pool, right_id)

        if op_str == "+"
            return "{\"Add\":[" + left_json + "," + right_json + "]}"
        elif op_str == "-"
            return "{\"Binary\":{\"op\":\"Sub\",\"left\":" + left_json + ",\"right\":" + right_json + "}}"
        elif op_str == "*"
            return "{\"Binary\":{\"op\":\"Mul\",\"left\":" + left_json + ",\"right\":" + right_json + "}}"
        elif op_str == "/"
            return "{\"Binary\":{\"op\":\"Div\",\"left\":" + left_json + ",\"right\":" + right_json + "}}"
        elif op_str == "=="
            return "{\"Binary\":{\"op\":\"Eq\",\"left\":" + left_json + ",\"right\":" + right_json + "}}"
        elif op_str == "!="
            return "{\"Binary\":{\"op\":\"Ne\",\"left\":" + left_json + ",\"right\":" + right_json + "}}"
        elif op_str == "<"
            return "{\"Binary\":{\"op\":\"Lt\",\"left\":" + left_json + ",\"right\":" + right_json + "}}"
        elif op_str == "<="
            return "{\"Binary\":{\"op\":\"Le\",\"left\":" + left_json + ",\"right\":" + right_json + "}}"
        elif op_str == ">"
            return "{\"Binary\":{\"op\":\"Gt\",\"left\":" + left_json + ",\"right\":" + right_json + "}}"
        elif op_str == ">="
            return "{\"Binary\":{\"op\":\"Ge\",\"left\":" + left_json + ",\"right\":" + right_json + "}}"
        else
            return "{\"Add\":[" + left_json + "," + right_json + "]}"
        end
    elif tag == 6 -- Call
        const callee = lists.get(pool.str_vals, id)
        const arg_id = lists.get(pool.left_ids, id)
        if arg_id == -1
            return "{\"Call\":{\"callee\":\"" + callee + "\",\"args\":[]}}"
        else
            const arg_json = emit_expr_json(pool, arg_id)
            return "{\"Call\":{\"callee\":\"" + callee + "\",\"args\":[" + arg_json + "]}}"
        end
    end

    return "{\"IntLit\":0}"
end

sanitize_json_str(s: string) -> string
    -- Strip outer quotes or f"..." prefix if present
    var clean = s
    if su.starts_with(clean, "f\"") and su.ends_with(clean, "\"") and su.len(clean) >= 3
        clean = su.slice(clean, 2, su.len(clean) - 1)
    elif su.starts_with(clean, "\"") and su.ends_with(clean, "\"") and su.len(clean) >= 2
        clean = su.slice(clean, 1, su.len(clean) - 1)
    end
    const no_backslash = su.replace(clean, "\\", "\\\\")
    return su.replace(no_backslash, "\"", "\\\"")
end

public emit_stmt_json(sp: stmts.StmtPool, pool: exprs.ExprPool, id: int) -> string
    if id < 0 or id >= lists.len(sp.kind_tags)
        return "{\"Return\":{\"IntLit\":0}}"
    end

    const tag = lists.get(sp.kind_tags, id)
    const expr_id = lists.get(sp.expr_ids, id)
    const target = lists.get(sp.target_names, id)

    if tag == 1 -- Const / Let
        const val_json = emit_expr_json(pool, expr_id)
        return "{\"Let\":{\"name\":\"" + target + "\",\"ty\":\"Int\",\"value\":" + val_json + "}}"
    elif tag == 2 -- Return
        const val_json = emit_expr_json(pool, expr_id)
        return "{\"Return\":" + val_json + "}"
    elif tag == 3 -- Expr
        const val_json = emit_expr_json(pool, expr_id)
        return "{\"Expr\":" + val_json + "}"
    elif tag == 4 -- If
        const cond_json = emit_expr_json(pool, expr_id)
        return "{\"If\":{\"cond\":" + cond_json + ",\"then_stmts\":[{\"Return\":{\"IntLit\":0}}],\"else_stmts\":[]}}"
    end

    return "{\"Return\":{\"IntLit\":0}}"
end

public emit_range_stmts_json(sp: stmts.StmtPool, pool: exprs.ExprPool, start_idx: int, end_idx: int) -> string
    if start_idx >= end_idx or start_idx < 0 or end_idx > lists.len(sp.kind_tags)
        return ""
    end

    const stmts_out: list[string] = []
    var i = start_idx
    while i < end_idx
        const s = emit_stmt_json(sp, pool, i)
        lists.push(stmts_out, s)
        i = i + 1
    end
    return su.join(stmts_out, ",")
end

public emit_all_stmts_json(sp: stmts.StmtPool, pool: exprs.ExprPool) -> string
    const count = lists.len(sp.kind_tags)
    if count == 0
        return "{\"Return\":{\"IntLit\":0}}"
    end

    const stmts_out: list[string] = []
    var i = 0
    while i < count
        const s = emit_stmt_json(sp, pool, i)
        lists.push(stmts_out, s)
        i = i + 1
    end
    return su.join(stmts_out, ",")
end
