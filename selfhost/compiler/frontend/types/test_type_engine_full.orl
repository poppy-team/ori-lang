module selfhost.compiler.frontend.types.test_type_engine_full

import ori.io as io
import selfhost.compiler.frontend.diag.sink as ds
import selfhost.compiler.frontend.parse.parse_expr as exprs
import selfhost.compiler.frontend.parse.parse_stmt as stmts
import selfhost.compiler.frontend.types.type_engine as te

main()
    const pool = exprs.new_pool()
    const sp = stmts.new_stmt_pool()
    const env = te.new_env()
    const sink = ds.new_sink()

    -- 1. Synthesize int literal 42
    const e_int = exprs.alloc_expr_raw(pool, 1, -1, -1, "42")
    const t_tag = te.infer_expr_tag(pool, e_int)
    io.println(f"INFER_INT_TAG: {t_tag}")

    -- 2. Const statement let x = 42
    const s_let = stmts.alloc_stmt_raw(sp, 1, e_int, "x")
    te.check_stmt(env, sink, sp, pool, s_let)
    io.println(f"ENV_BINDINGS: {te.binding_count(env)}")

    -- 3. Return statement
    const s_ret = stmts.alloc_stmt_raw(sp, 2, e_int, "")
    te.check_stmt(env, sink, sp, pool, s_ret)

    -- 4. Check all statements batch
    const errs = te.check_all_statements(env, sink, sp, pool)
    io.println(f"TOTAL_TYPE_ERRORS: {errs}")

    io.println("F_TYPE_SUITE_SUCCESS")
end
