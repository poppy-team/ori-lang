module selfhost.compiler.frontend.parse.parse_expr

import ori.list as lists
import selfhost.compiler.frontend.lex.token as tok
import selfhost.compiler.frontend.parse.node as node

public struct ExprPool
    kind_tags: list[int] -- 1=IntLit, 2=StrLit, 3=BoolLit, 4=Ident, 5=Binary, 6=Call, 7=EmptyList
    left_ids: list[int]
    right_ids: list[int]
    str_vals: list[string]
end

public new_pool() -> ExprPool
    const empty_k: list[int] = []
    const empty_l: list[int] = []
    const empty_r: list[int] = []
    const empty_s: list[string] = []
    return ExprPool {
        kind_tags: empty_k,
        left_ids: empty_l,
        right_ids: empty_r,
        str_vals: empty_s
    }
end

public alloc_expr_raw(pool: ExprPool, kind_tag: int, left: int, right: int, val: string) -> int
    const id = lists.len(pool.kind_tags)
    lists.push(pool.kind_tags, kind_tag)
    lists.push(pool.left_ids, left)
    lists.push(pool.right_ids, right)
    lists.push(pool.str_vals, val)
    return id
end

-- Backward compatible alloc_expr helper
public alloc_expr(pool: ExprPool, kind: node.ExprKind, span: tok.Span) -> int
    match kind
    case Lit(lit):
        match lit
        case Int(raw): return alloc_expr_raw(pool, 1, -1, -1, raw)
        case Str(val): return alloc_expr_raw(pool, 2, -1, -1, val)
        case Bool(val):
            if val
                return alloc_expr_raw(pool, 3, -1, -1, "true")
            else
                return alloc_expr_raw(pool, 3, -1, -1, "false")
            end
        case else: return alloc_expr_raw(pool, 0, -1, -1, "")
        end
    case Ident(name):
        return alloc_expr_raw(pool, 4, -1, -1, name)
    case Binary(op, left_id, right_id):
        return alloc_expr_raw(pool, 5, left_id, right_id, "")
    case Call(callee, arg_ids):
        return alloc_expr_raw(pool, 6, lists.len(arg_ids), -1, callee)
    case else:
        return alloc_expr_raw(pool, 0, -1, -1, "")
    end
end

public struct ParseExprOut
    expr_id: int
    next_cursor: int
end

public parse_primary(tokens: list[tok.Token], cursor: int, pool: ExprPool) -> optional[ParseExprOut]
    if cursor >= lists.len(tokens)
        return none
    end

    const t = lists.get(tokens, cursor)
    match t.kind
    case IntLit(raw):
        const id = alloc_expr_raw(pool, 1, -1, -1, raw)
        return some(ParseExprOut { expr_id: id, next_cursor: cursor + 1 })
    case FloatLit(raw):
        const id = alloc_expr_raw(pool, 1, -1, -1, raw)
        return some(ParseExprOut { expr_id: id, next_cursor: cursor + 1 })
    case StrLit(value):
        const id = alloc_expr_raw(pool, 2, -1, -1, value)
        return some(ParseExprOut { expr_id: id, next_cursor: cursor + 1 })
    case FStrLit(raw):
        const id = alloc_expr_raw(pool, 2, -1, -1, raw)
        return some(ParseExprOut { expr_id: id, next_cursor: cursor + 1 })
    case True:
        const id = alloc_expr_raw(pool, 3, -1, -1, "true")
        return some(ParseExprOut { expr_id: id, next_cursor: cursor + 1 })
    case False:
        const id = alloc_expr_raw(pool, 3, -1, -1, "false")
        return some(ParseExprOut { expr_id: id, next_cursor: cursor + 1 })
    case None:
        const id = alloc_expr_raw(pool, 0, -1, -1, "none")
        return some(ParseExprOut { expr_id: id, next_cursor: cursor + 1 })
    case Match:
        -- Match as expression: match scrutinee case ... end
        var m_cur = cursor + 1
        var depth = 1
        while m_cur < lists.len(tokens) and depth > 0
            const mt = lists.get(tokens, m_cur)
            match mt.kind
            case End:
                depth = depth - 1
                m_cur = m_cur + 1
            case Match:
                depth = depth + 1
                m_cur = m_cur + 1
            case else:
                m_cur = m_cur + 1
            end
        end
        const id = alloc_expr_raw(pool, 10, -1, -1, "match_expr")
        return some(ParseExprOut { expr_id: id, next_cursor: m_cur })
    case LBracket:
        -- Typed empty lists are common in compiler code. Preserve a distinct
        -- node; code generation rejects it until collection lowering exists.
        if cursor + 1 < lists.len(tokens)
            const close_tok = lists.get(tokens, cursor + 1)
            match close_tok.kind
            case RBracket:
                const id = alloc_expr_raw(pool, 7, -1, -1, "")
                return some(ParseExprOut { expr_id: id, next_cursor: cursor + 2 })
            case else:
            end
        end
        return none
    case Ident(name):
        if cursor + 1 < lists.len(tokens)
            const next_tok = lists.get(tokens, cursor + 1)
            match next_tok.kind
            case LParen:
                return parse_call(tokens, cursor, pool, name, t.span)
            case else:
                const id = alloc_expr_raw(pool, 4, -1, -1, name)
                return some(ParseExprOut { expr_id: id, next_cursor: cursor + 1 })
            end
        end
        const id = alloc_expr_raw(pool, 4, -1, -1, name)
        return some(ParseExprOut { expr_id: id, next_cursor: cursor + 1 })
    case else:
        return none
    end
end

parse_call(tokens: list[tok.Token], cursor: int, pool: ExprPool, fn_name: string, span: tok.Span) -> optional[ParseExprOut]
    var cur = cursor + 2 -- Skip ident and '('
    var first_arg_id = -1
    while cur < lists.len(tokens)
        const t = lists.get(tokens, cur)
        match t.kind
        case RParen:
            const id = alloc_expr_raw(pool, 6, first_arg_id, -1, fn_name)
            return some(ParseExprOut { expr_id: id, next_cursor: cur + 1 })
        case Comma:
            cur = cur + 1
        case else:
            match parse_primary(tokens, cur, pool)
            case some(out):
                if first_arg_id == -1
                    first_arg_id = out.expr_id
                end
                cur = out.next_cursor
            case none:
                return none
            end
        end
    end
    return none
end

public parse_binary(tokens: list[tok.Token], cursor: int, pool: ExprPool) -> optional[ParseExprOut]
    match parse_primary(tokens, cursor, pool)
    case some(left_out):
        var cur = left_out.next_cursor
        var current_id = left_out.expr_id

        while cur < lists.len(tokens)
            const t = lists.get(tokens, cur)
            match t.kind
            case Plus:
                match parse_primary(tokens, cur + 1, pool)
                case some(right_out):
                    current_id = alloc_expr_raw(pool, 5, current_id, right_out.expr_id, "+")
                    cur = right_out.next_cursor
                case none:
                    return some(ParseExprOut { expr_id: current_id, next_cursor: cur })
                end
            case Minus:
                match parse_primary(tokens, cur + 1, pool)
                case some(right_out):
                    current_id = alloc_expr_raw(pool, 5, current_id, right_out.expr_id, "-")
                    cur = right_out.next_cursor
                case none:
                    return some(ParseExprOut { expr_id: current_id, next_cursor: cur })
                end
            case Pipe:
                match parse_primary(tokens, cur + 1, pool)
                case some(right_out):
                    current_id = alloc_expr_raw(pool, 5, current_id, right_out.expr_id, "|>")
                    cur = right_out.next_cursor
                case none:
                    return some(ParseExprOut { expr_id: current_id, next_cursor: cur })
                end
            case else:
                return some(ParseExprOut { expr_id: current_id, next_cursor: cur })
            end
        end
        return some(ParseExprOut { expr_id: current_id, next_cursor: cur })
    case none:
        return none
    end
end

public total_exprs(pool: ExprPool) -> int
    return lists.len(pool.kind_tags)
end
