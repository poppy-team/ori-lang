module selfhost.compiler.frontend.parse.parse_import

import ori.list as lists
import selfhost.compiler.frontend.lex.token as tok
import selfhost.compiler.frontend.parse.node as node

public struct ParseImportOut
    import_node: node.ImportNode
    next_cursor: int
end

public struct ModuleHeaderOut
    name: string
    next_cursor: int
end

-- Built-in stdlib modules may have names that are also type keywords. The
-- lexer classifies these as keywords, while a dotted module path still needs
-- their source spelling in both imports and module declarations.
path_segment(kind: tok.TokenKind) -> optional[string]
    match kind
    case Ident(name): return some(name)
    case List: return some("list")
    case Map: return some("map")
    case Set: return some("set")
    case StringTy: return some("string")
    case BytesTy: return some("bytes")
    case Range: return some("range")
    case else: return none
    end
end

public parse_module_header(tokens: list[tok.Token], cursor: int) -> optional[ModuleHeaderOut]
    if cursor + 1 >= lists.len(tokens)
        return none
    end

    const mod_tok = lists.get(tokens, cursor)
    match mod_tok.kind
    case Module:
        const path_tok = lists.get(tokens, cursor + 1)
        match path_segment(path_tok.kind)
        case some(first):
            var full: string = first
            var p_cur = cursor + 2
            var scanning = true
            while scanning and p_cur + 1 < lists.len(tokens)
                const dot_tok = lists.get(tokens, p_cur)
                match dot_tok.kind
                case Dot:
                    const seg_tok = lists.get(tokens, p_cur + 1)
                    match path_segment(seg_tok.kind)
                    case some(segment):
                        full = full + "." + segment
                        p_cur = p_cur + 2
                    case none:
                        scanning = false
                    end
                case else:
                    scanning = false
                end
            end
            return some(ModuleHeaderOut { name: full, next_cursor: p_cur })
        case none:
            return none
        end
    case else:
        return none
    end
end

public parse_import_decl(tokens: list[tok.Token], cursor: int) -> optional[ParseImportOut]
    if cursor + 2 >= lists.len(tokens)
        return none
    end

    const imp_tok = lists.get(tokens, cursor)
    match imp_tok.kind
    case Import:
        const path_tok = lists.get(tokens, cursor + 1)
        match path_segment(path_tok.kind)
        case some(first):
            var full_path: string = first
            var path_cur = cursor + 2
            var scanning = true
            while scanning and path_cur + 1 < lists.len(tokens)
                const dot_tok = lists.get(tokens, path_cur)
                match dot_tok.kind
                case Dot:
                    const seg_tok = lists.get(tokens, path_cur + 1)
                    match path_segment(seg_tok.kind)
                    case some(segment):
                        full_path = full_path + "." + segment
                        path_cur = path_cur + 2
                    case none:
                        scanning = false
                    end
                case else:
                    scanning = false
                end
            end
            if path_cur >= lists.len(tokens)
                return none
            end
            const alias_tok = lists.get(tokens, path_cur)
            match alias_tok.kind
            case LParen:
                -- Selective import: import path (A, B, C)
                var p_cur = path_cur + 1
                while p_cur < lists.len(tokens)
                    const item_tok = lists.get(tokens, p_cur)
                    match item_tok.kind
                    case RParen:
                        const imp = node.ImportNode {
                            module_path: full_path,
                            alias_name: full_path,
                            span: imp_tok.span
                        }
                        return some(ParseImportOut { import_node: imp, next_cursor: p_cur + 1 })
                    case else:
                        p_cur = p_cur + 1
                    end
                end
                return none
            case As:
                if path_cur + 1 >= lists.len(tokens)
                    return none
                end
                const final_tok = lists.get(tokens, path_cur + 1)
                match final_tok.kind
                case Ident(name):
                    const imp_alias: string = name
                    const imp = node.ImportNode {
                        module_path: full_path,
                        alias_name: imp_alias,
                        span: imp_tok.span
                    }
                    return some(ParseImportOut { import_node: imp, next_cursor: path_cur + 2 })
                case else:
                    return none
                end
            case else:
                const imp = node.ImportNode {
                    module_path: full_path,
                    alias_name: full_path,
                    span: imp_tok.span
                }
                return some(ParseImportOut { import_node: imp, next_cursor: path_cur })
            end
        case none:
            return none
        end
    case else:
        return none
    end
end
