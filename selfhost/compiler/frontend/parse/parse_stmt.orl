module selfhost.compiler.frontend.parse.parse_stmt

import ori.list as lists
import selfhost.compiler.frontend.lex.token as tok
import selfhost.compiler.frontend.parse.node as node
import selfhost.compiler.frontend.parse.parse_expr as exprs
import selfhost.compiler.frontend.parse.parse_pat as ppat
import selfhost.compiler.frontend.parse.parse_ty as pty
import selfhost.compiler.frontend.parse.postfix as pf
import selfhost.compiler.frontend.parse.pratt as pr

public struct StmtPool
    kind_tags: list[int] -- 1=Let, 2=Return, 3=Expr, 4=If, 5=While, 6=Assign, 7=Break, 8=Continue
    expr_ids: list[int]
    target_names: list[string]
    type_annotations: list[string]
    mutable_flags: list[int]
    branch_starts: list[int] -- first statement of an else branch, or subtree end
    subtree_ends: list[int] -- exclusive end of this statement's descendants
end

public new_stmt_pool() -> StmtPool
    const empty_k: list[int] = []
    const empty_e: list[int] = []
    const empty_t: list[string] = []
    const empty_a: list[string] = []
    const empty_m: list[int] = []
    const empty_b: list[int] = []
    const empty_end: list[int] = []
    return StmtPool {
        kind_tags: empty_k,
        expr_ids: empty_e,
        target_names: empty_t,
        type_annotations: empty_a,
        mutable_flags: empty_m,
        branch_starts: empty_b,
        subtree_ends: empty_end
    }
end

public alloc_stmt_raw(pool: StmtPool, kind: int, expr_id: int, target: string) -> int
    const id = lists.len(pool.kind_tags)
    lists.push(pool.kind_tags, kind)
    lists.push(pool.expr_ids, expr_id)
    lists.push(pool.target_names, target)
    lists.push(pool.type_annotations, "")
    lists.push(pool.mutable_flags, 0)
    lists.push(pool.branch_starts, id + 1)
    lists.push(pool.subtree_ends, id + 1)
    return id
end

-- Backward compatible alloc_stmt
public alloc_stmt(pool: StmtPool, kind: node.StmtKind, span: tok.Span) -> int
    match kind
    case Const(name, ty_annot, expr_id):
        return alloc_stmt_raw(pool, 1, expr_id, name.text)
    case Return(expr_id):
        return alloc_stmt_raw(pool, 2, expr_id, "")
    case Expr(expr_id):
        return alloc_stmt_raw(pool, 3, expr_id, "")
    case else:
        return alloc_stmt_raw(pool, 0, -1, "")
    end
end

public struct ParseStmtOut
    stmt_id: int
    next_cursor: int
end

public parse_let(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool, mutable: bool) -> optional[ParseStmtOut]
    if cursor + 3 >= lists.len(tokens)
        return none
    end

    const name_tok = lists.get(tokens, cursor + 1)
    match name_tok.kind
    case LBrace:
        -- Struct destructuring: const { x, y } = val
        const pat_pool = ppat.new_pat_pool()
        match ppat.parse_pattern(tokens, cursor + 1, pat_pool)
        case none:
            return none
        case some(pat_out):
            if pat_out.next_cursor >= lists.len(tokens)
                return none
            end
            match exprs.parse_binary(tokens, pat_out.next_cursor + 1, pool)
            case some(val_out):
                const stmt_id = alloc_stmt_raw(sp, 3, val_out.expr_id, "destructure")
                return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: val_out.next_cursor })
            case none:
                return none
            end
        end
    case Ident(name):
        const ty_tok = lists.get(tokens, cursor + 2)
        match ty_tok.kind
        case Eq:
            -- Local inference: const/var name = expression.
            match pr.parse_with_precedence(tokens, cursor + 3, pool, 0)
            case some(val_out):
                const stmt_id = alloc_stmt_raw(sp, 1, val_out.expr_id, name)
                if mutable
                    lists.set(sp.mutable_flags, stmt_id, 1)
                end
                return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: val_out.next_cursor })
            case none:
                return none
            end
        case Colon:
            const val_name = name
            var eq_cursor = -1
            const type_start = lists.get(tokens, cursor + 3)
            var declared_ty = "unsupported"
            match type_start.kind
            case IntTy:
                declared_ty = "int"
                eq_cursor = cursor + 4
            case BoolTy:
                declared_ty = "bool"
                eq_cursor = cursor + 4
            case StringTy:
                declared_ty = "string"
                eq_cursor = cursor + 4
            case FloatTy:
                declared_ty = "float"
                eq_cursor = cursor + 4
            case Ident(name):
                declared_ty = name
                eq_cursor = cursor + 4
            case List:
                -- This local annotation only needs a cursor. Avoid storing
                -- a nested TyNode in a temporary pool that is discarded.
                if cursor + 7 < lists.len(tokens)
                    const open = lists.get(tokens, cursor + 4)
                    const elem = lists.get(tokens, cursor + 5)
                    const close = lists.get(tokens, cursor + 6)
                    var valid_elem = false
                    match elem.kind
                    case IntTy: valid_elem = true
                    case StringTy: valid_elem = true
                    case BoolTy: valid_elem = true
                    case FloatTy: valid_elem = true
                    case Ident(name): valid_elem = true
                    case else:
                    end
                    match open.kind
                    case LBracket:
                        match close.kind
                        case RBracket:
                            if valid_elem
                                eq_cursor = cursor + 7
                            end
                        case else:
                        end
                    case else:
                    end
                end
            case else:
                const ty_pool = pty.new_ty_pool()
                match pty.parse_type_ref(tokens, cursor + 3, ty_pool)
                case some(ty_out):
                    eq_cursor = ty_out.next_cursor
                case none:
                end
            end
            if eq_cursor < 0 or eq_cursor >= lists.len(tokens)
                return none
            end
            const eq_tok = lists.get(tokens, eq_cursor)
            match eq_tok.kind
            case Eq:
                match pr.parse_with_precedence(tokens, eq_cursor + 1, pool, 0)
                case some(val_out):
                    const stmt_id = alloc_stmt_raw(sp, 1, val_out.expr_id, val_name)
                    lists.set(sp.type_annotations, stmt_id, declared_ty)
                    if mutable
                        lists.set(sp.mutable_flags, stmt_id, 1)
                    end
                    return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: val_out.next_cursor })
                case none:
                    return none
                end
            case else:
                return none
            end
        case else:
            return none
        end
    case else:
        return none
    end
end

public parse_return(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool) -> optional[ParseStmtOut]
    match pr.parse_with_precedence(tokens, cursor + 1, pool, 0)
    case some(out):
        const stmt_id = alloc_stmt_raw(sp, 2, out.expr_id, "")
        return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: out.next_cursor })
    case none:
        const stmt_id = alloc_stmt_raw(sp, 2, -1, "")
        return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: cursor + 1 })
    end
end

-- All statements are stored in preorder. Each block parent records where its
-- branches start and its exclusive end, so no nested body can be dropped.
parse_block(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool, allow_else: bool) -> int
    var cur = cursor
    while cur < lists.len(tokens)
        const token = lists.get(tokens, cur)
        match token.kind
        case End:
            return cur
        case Else:
            if allow_else
                return cur
            end
            alloc_stmt_raw(sp, 0, -1, "unexpected_else")
            cur = cur + 1
        case Elif:
            if allow_else
                return cur
            end
            alloc_stmt_raw(sp, 0, -1, "unexpected_elif")
            cur = cur + 1
        case else:
            match parse_statement(tokens, cur, pool, sp)
            case some(out):
                if out.next_cursor > cur
                    cur = out.next_cursor
                else
                    alloc_stmt_raw(sp, 0, -1, "invalid_statement_cursor")
                    cur = cur + 1
                end
            case none:
                alloc_stmt_raw(sp, 0, -1, "unsupported_statement")
                cur = cur + 1
            end
        end
    end
    return cur
end

-- An elif is the else branch of the previous conditional and has no End of
-- its own. Store it as a nested If, leaving the shared End for the caller.
parse_if_branch(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool) -> optional[ParseStmtOut]
    match pr.parse_with_precedence(tokens, cursor + 1, pool, 0)
    case some(cond_out):
        const stmt_id = alloc_stmt_raw(sp, 4, cond_out.expr_id, "")
        var cur = parse_block(tokens, cond_out.next_cursor, pool, sp, true)
        lists.set(sp.branch_starts, stmt_id, lists.len(sp.kind_tags))
        if cur < lists.len(tokens)
            const boundary = lists.get(tokens, cur)
            match boundary.kind
            case Else:
                cur = parse_block(tokens, cur + 1, pool, sp, false)
            case Elif:
                match parse_if_branch(tokens, cur, pool, sp)
                case some(out):
                    cur = out.next_cursor
                case none:
                    alloc_stmt_raw(sp, 0, -1, "invalid_elif")
                    cur = cur + 1
                end
            case else:
            end
        end
        lists.set(sp.subtree_ends, stmt_id, lists.len(sp.kind_tags))
        return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: cur })
    case none:
        return none
    end
end

public parse_if(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool) -> optional[ParseStmtOut]
    match parse_if_branch(tokens, cursor, pool, sp)
    case some(out):
        const cur = out.next_cursor
        if cur < lists.len(tokens)
            const closing = lists.get(tokens, cur)
            match closing.kind
            case End:
                return some(ParseStmtOut { stmt_id: out.stmt_id, next_cursor: cur + 1 })
            case else:
            end
        end
        alloc_stmt_raw(sp, 0, -1, "unterminated_if")
        return some(out)
    case none:
        return none
    end
end

public parse_while(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool) -> optional[ParseStmtOut]
    match pr.parse_with_precedence(tokens, cursor + 1, pool, 0)
    case some(cond_out):
        const stmt_id = alloc_stmt_raw(sp, 5, cond_out.expr_id, "")
        const cur = parse_block(tokens, cond_out.next_cursor, pool, sp, false)
        const end_idx = lists.len(sp.kind_tags)
        lists.set(sp.branch_starts, stmt_id, end_idx)
        lists.set(sp.subtree_ends, stmt_id, end_idx)
        if cur < lists.len(tokens)
            return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: cur + 1 })
        end
        alloc_stmt_raw(sp, 0, -1, "unterminated_while")
        return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: cur })
    case none:
        return none
    end
end

public parse_statement(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool) -> optional[ParseStmtOut]
    if cursor >= lists.len(tokens)
        return none
    end

    const t = lists.get(tokens, cursor)
    match t.kind
    case Const:
        return parse_let(tokens, cursor, pool, sp, false)
    case Var:
        return parse_let(tokens, cursor, pool, sp, true)
    case Return:
        return parse_return(tokens, cursor, pool, sp)
    case If:
        return parse_if(tokens, cursor, pool, sp)
    case While:
        return parse_while(tokens, cursor, pool, sp)
    case Break:
        const stmt_id = alloc_stmt_raw(sp, 7, -1, "")
        return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: cursor + 1 })
    case Continue:
        const stmt_id = alloc_stmt_raw(sp, 8, -1, "")
        return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: cursor + 1 })
    case Ident(name):
        if cursor + 1 < lists.len(tokens)
            const next_tok = lists.get(tokens, cursor + 1)
            match next_tok.kind
            case Eq:
                match pr.parse_with_precedence(tokens, cursor + 2, pool, 0)
                case some(out):
                    const stmt_id = alloc_stmt_raw(sp, 6, out.expr_id, name)
                    return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: out.next_cursor })
                case none:
                    return none
                end
            case else:
            end
        end
        match pf.parse_postfix_chain(tokens, cursor, pool)
        case some(out):
            const stmt_id = alloc_stmt_raw(sp, 3, out.expr_id, "")
            return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: out.next_cursor })
        case none:
            return none
        end
    case else:
        match pf.parse_postfix_chain(tokens, cursor, pool)
        case some(out):
            const stmt_id = alloc_stmt_raw(sp, 3, out.expr_id, "")
            return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: out.next_cursor })
        case none:
            match pr.parse_with_precedence(tokens, cursor, pool, 0)
            case some(out):
                const stmt_id = alloc_stmt_raw(sp, 3, out.expr_id, "")
                return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: out.next_cursor })
            case none:
                return none
            end
        end
    end
end

public total_stmts(sp: StmtPool) -> int
    return lists.len(sp.kind_tags)
end
