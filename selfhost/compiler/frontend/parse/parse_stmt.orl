module selfhost.compiler.frontend.parse.parse_stmt

import ori.list as lists
import selfhost.compiler.frontend.lex.token as tok
import selfhost.compiler.frontend.parse.node as node
import selfhost.compiler.frontend.parse.parse_expr as exprs
import selfhost.compiler.frontend.parse.parse_pat as ppat
import selfhost.compiler.frontend.parse.parse_ty as pty
import selfhost.compiler.frontend.parse.postfix as pf
import selfhost.compiler.frontend.parse.pratt as pr

public struct StmtPool
    kind_tags: list[int] -- 1=Const, 2=Return, 3=Expr, 4=If
    expr_ids: list[int]
    target_names: list[string]
    type_annotations: list[string]
end

public new_stmt_pool() -> StmtPool
    const empty_k: list[int] = []
    const empty_e: list[int] = []
    const empty_t: list[string] = []
    const empty_a: list[string] = []
    return StmtPool {
        kind_tags: empty_k,
        expr_ids: empty_e,
        target_names: empty_t,
        type_annotations: empty_a
    }
end

public alloc_stmt_raw(pool: StmtPool, kind: int, expr_id: int, target: string) -> int
    const id = lists.len(pool.kind_tags)
    lists.push(pool.kind_tags, kind)
    lists.push(pool.expr_ids, expr_id)
    lists.push(pool.target_names, target)
    lists.push(pool.type_annotations, "")
    return id
end

-- Backward compatible alloc_stmt
public alloc_stmt(pool: StmtPool, kind: node.StmtKind, span: tok.Span) -> int
    match kind
    case Const(name, ty_annot, expr_id):
        return alloc_stmt_raw(pool, 1, expr_id, name.text)
    case Return(expr_id):
        return alloc_stmt_raw(pool, 2, expr_id, "")
    case Expr(expr_id):
        return alloc_stmt_raw(pool, 3, expr_id, "")
    case else:
        return alloc_stmt_raw(pool, 0, -1, "")
    end
end

public struct ParseStmtOut
    stmt_id: int
    next_cursor: int
end

public parse_let(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool) -> optional[ParseStmtOut]
    if cursor + 3 >= lists.len(tokens)
        return none
    end

    const name_tok = lists.get(tokens, cursor + 1)
    match name_tok.kind
    case LBrace:
        -- Struct destructuring: const { x, y } = val
        const pat_pool = ppat.new_pat_pool()
        match ppat.parse_pattern(tokens, cursor + 1, pat_pool)
        case none:
            return none
        case some(pat_out):
            if pat_out.next_cursor >= lists.len(tokens)
                return none
            end
            match exprs.parse_binary(tokens, pat_out.next_cursor + 1, pool)
            case some(val_out):
                const stmt_id = alloc_stmt_raw(sp, 3, val_out.expr_id, "destructure")
                return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: val_out.next_cursor })
            case none:
                return none
            end
        end
    case Ident(name):
        const ty_tok = lists.get(tokens, cursor + 2)
        match ty_tok.kind
        case Eq:
            -- Local inference: const/var name = expression.
            match pr.parse_with_precedence(tokens, cursor + 3, pool, 0)
            case some(val_out):
                const stmt_id = alloc_stmt_raw(sp, 1, val_out.expr_id, name)
                return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: val_out.next_cursor })
            case none:
                return none
            end
        case Colon:
            const val_name = name
            var eq_cursor = -1
            const type_start = lists.get(tokens, cursor + 3)
            var declared_ty = "unsupported"
            match type_start.kind
            case IntTy:
                declared_ty = "int"
                eq_cursor = cursor + 4
            case BoolTy:
                declared_ty = "bool"
                eq_cursor = cursor + 4
            case StringTy:
                declared_ty = "string"
                eq_cursor = cursor + 4
            case FloatTy:
                declared_ty = "float"
                eq_cursor = cursor + 4
            case Ident(name):
                declared_ty = name
                eq_cursor = cursor + 4
            case List:
                -- This local annotation only needs a cursor. Avoid storing
                -- a nested TyNode in a temporary pool that is discarded.
                if cursor + 7 < lists.len(tokens)
                    const open = lists.get(tokens, cursor + 4)
                    const elem = lists.get(tokens, cursor + 5)
                    const close = lists.get(tokens, cursor + 6)
                    var valid_elem = false
                    match elem.kind
                    case IntTy: valid_elem = true
                    case StringTy: valid_elem = true
                    case BoolTy: valid_elem = true
                    case FloatTy: valid_elem = true
                    case Ident(name): valid_elem = true
                    case else:
                    end
                    match open.kind
                    case LBracket:
                        match close.kind
                        case RBracket:
                            if valid_elem
                                eq_cursor = cursor + 7
                            end
                        case else:
                        end
                    case else:
                    end
                end
            case else:
                const ty_pool = pty.new_ty_pool()
                match pty.parse_type_ref(tokens, cursor + 3, ty_pool)
                case some(ty_out):
                    eq_cursor = ty_out.next_cursor
                case none:
                end
            end
            if eq_cursor < 0 or eq_cursor >= lists.len(tokens)
                return none
            end
            const eq_tok = lists.get(tokens, eq_cursor)
            match eq_tok.kind
            case Eq:
                match pr.parse_with_precedence(tokens, eq_cursor + 1, pool, 0)
                case some(val_out):
                    const stmt_id = alloc_stmt_raw(sp, 1, val_out.expr_id, val_name)
                    lists.set(sp.type_annotations, stmt_id, declared_ty)
                    return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: val_out.next_cursor })
                case none:
                    return none
                end
            case else:
                return none
            end
        case else:
            return none
        end
    case else:
        return none
    end
end

public parse_return(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool) -> optional[ParseStmtOut]
    match pr.parse_with_precedence(tokens, cursor + 1, pool, 0)
    case some(out):
        const stmt_id = alloc_stmt_raw(sp, 2, out.expr_id, "")
        return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: out.next_cursor })
    case none:
        return none
    end
end

public parse_if(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool) -> optional[ParseStmtOut]
    match pr.parse_with_precedence(tokens, cursor + 1, pool, 0)
    case some(cond_out):
        var cur = cond_out.next_cursor
        while cur < lists.len(tokens)
            const t = lists.get(tokens, cur)
            match t.kind
            case End:
                const stmt_id = alloc_stmt_raw(sp, 4, cond_out.expr_id, "")
                return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: cur + 1 })
            case else:
                cur = cur + 1
            end
        end
        return none
    case none:
        return none
    end
end

public parse_statement(tokens: list[tok.Token], cursor: int, pool: exprs.ExprPool, sp: StmtPool) -> optional[ParseStmtOut]
    if cursor >= lists.len(tokens)
        return none
    end

    const t = lists.get(tokens, cursor)
    match t.kind
    case Const:
        return parse_let(tokens, cursor, pool, sp)
    case Var:
        return parse_let(tokens, cursor, pool, sp)
    case Return:
        return parse_return(tokens, cursor, pool, sp)
    case If:
        return parse_if(tokens, cursor, pool, sp)
    case else:
        match pf.parse_postfix_chain(tokens, cursor, pool)
        case some(out):
            const stmt_id = alloc_stmt_raw(sp, 3, out.expr_id, "")
            return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: out.next_cursor })
        case none:
            match pr.parse_with_precedence(tokens, cursor, pool, 0)
            case some(out):
                const stmt_id = alloc_stmt_raw(sp, 3, out.expr_id, "")
                return some(ParseStmtOut { stmt_id: stmt_id, next_cursor: out.next_cursor })
            case none:
                return none
            end
        end
    end
end

public total_stmts(sp: StmtPool) -> int
    return lists.len(sp.kind_tags)
end
