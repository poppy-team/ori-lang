module selfhost.compiler.frontend.lex.token

public newtype ByteOffset = int

public struct Span
    start_pos: ByteOffset
    end_pos: ByteOffset
end

public span_len(s: Span) -> int
    const lo: int = int(s.start_pos)
    const hi: int = int(s.end_pos)
    return hi - lo
end

public enum TokenKind
    Invalid
    LineComment
    BlockComment
    Module
    Import
    As
    Public
    Func
    Return
    End
    Const
    Var
    If
    Else
    Elif
    While
    For
    In
    Repeat
    Break
    Continue
    Match
    Case
    Loop
    Struct
    Trait
    Apply
    Using
    Check
    With
    Then
    Enum
    Where
    Is
    Alias
    Newtype
    Do
    And
    Or
    Not
    True
    False
    None
    Some
    Mut
    SelfKw
    Attr
    Extern
    Any
    Optional
    ResultKw
    List
    Map
    Set
    Range
    Void
    BoolTy
    IntTy
    Int8Ty
    Int16Ty
    Int32Ty
    Int64Ty
    U8Ty
    U16Ty
    U32Ty
    U64Ty
    FloatTy
    Float32Ty
    Float64Ty
    StringTy
    BytesTy
    Ident(name: string)
    IntLit(raw: string)
    FloatLit(raw: string)
    StrLit(value: string)
    FStrLit(raw: string)
    BytesLit(raw: string)
    FatArrow
    Arrow
    Pipe
    Eq
    EqEq
    BangEq
    LtEq
    GtEq
    Lt
    Gt
    Plus
    Minus
    Star
    Slash
    Percent
    Caret
    Amp
    Bar
    Tilde
    Shl
