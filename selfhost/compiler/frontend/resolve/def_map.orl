module selfhost.compiler.frontend.resolve.def_map

import ori.list as lists
import ori.string as su
import selfhost.compiler.frontend.diag.sink as ds

public struct DefItem
    id: int
    name: string
    canonical_path: string
    kind_code: int -- 1=Struct, 2=Enum, 3=Trait, 4=Func, 5=Const, 6=Var, 7=TypeAlias, 8=Newtype, 9=Extern
    is_public: bool
end

public struct DefMap
    names: list[string]
    paths: list[string]
    kinds: list[int]
    is_public_flags: list[int]
end

public new_def_map() -> DefMap
    const empty_n: list[string] = []
    const empty_p: list[string] = []
    const empty_k: list[int] = []
    const empty_pub: list[int] = []
    return DefMap {
        names: empty_n,
        paths: empty_p,
        kinds: empty_k,
        is_public_flags: empty_pub
    }
end

public lookup_def_id(dmap: DefMap, name: string) -> optional[int]
    var i = 0
    const count = lists.len(dmap.names)
    while i < count
        if lists.get(dmap.names, i) == name
            return some(i)
        end
        i = i + 1
    end
    return none
end

public register_def(
    dmap: DefMap,
    sink: ds.DiagnosticSink,
    name: string,
    canonical_path: string,
    kind_code: int,
    is_pub: bool
) -> int
    match lookup_def_id(dmap, name)
    case some(_):
        ds.emit_error(sink, "name.duplicate_definition", "duplicate definition: " + name, "rename one of the items or qualify with module")
        return -1
    case none:
        const id = lists.len(dmap.names)
        lists.push(dmap.names, name)
        lists.push(dmap.paths, canonical_path)
        lists.push(dmap.kinds, kind_code)
        lists.push(dmap.is_public_flags, if is_pub then 1 else 0)
        return id
    end
end

public pass1_collect_declarations(
    dmap: DefMap,
    sink: ds.DiagnosticSink,
    module_name: string,
    func_names: list[string],
    struct_names: list[string],
    enum_names: list[string]
)
    -- 1. Register Structs (kind 1)
    var s_idx = 0
    while s_idx < lists.len(struct_names)
        const sname = lists.get(struct_names, s_idx)
        register_def(dmap, sink, sname, module_name + "." + sname, 1, true)
        s_idx = s_idx + 1
    end

    -- 2. Register Enums (kind 2)
    var e_idx = 0
    while e_idx < lists.len(enum_names)
        const ename = lists.get(enum_names, e_idx)
        register_def(dmap, sink, ename, module_name + "." + ename, 2, true)
        e_idx = e_idx + 1
    end

    -- 3. Register Functions (kind 4)
    var f_idx = 0
    while f_idx < lists.len(func_names)
        const fname = lists.get(func_names, f_idx)
        register_def(dmap, sink, fname, module_name + "." + fname, 4, true)
        f_idx = f_idx + 1
    end
end

public pass2_resolve_references(
    dmap: DefMap,
    sink: ds.DiagnosticSink,
    referenced_names: list[string]
)
    var i = 0
    const total = lists.len(referenced_names)
    while i < total
        const ref_name = lists.get(referenced_names, i)
        if not is_expr_noise(ref_name)
            match lookup_def_id(dmap, ref_name)
            case some(_):
            case none:
                if not is_builtin_or_primitive(ref_name)
                    ds.emit_error(sink, "name.undefined", "undefined identifier: " + ref_name, "ensure it is defined in this module or imported")
                end
            end
        end
        i = i + 1
    end
end

public pass2_resolve_idents_only(
    dmap: DefMap,
    sink: ds.DiagnosticSink,
    kind_tags: list[int],
    names: list[string]
)
    var i = 0
    const total = lists.len(kind_tags)
    while i < total
        const tag = lists.get(kind_tags, i)
        if tag == 4 -- Ident / Var only
            const ref_name = lists.get(names, i)
            if ref_name == ""
                ds.emit_error(sink, "parse.unexpected_token", "empty identifier in parsed expression", "fix the lexer or parser before emitting IR")
            elif not is_builtin_or_primitive(ref_name)
                match lookup_def_id(dmap, ref_name)
                case some(_):
                case none:
                    ds.emit_error(sink, "name.undefined", "undefined identifier: " + ref_name, "ensure it is defined in this module or imported")
                end
            end
        end
        i = i + 1
    end
end

-- The global definition map records local names for lookup, but a binding
-- from another function (or a later statement) is not visible here. Traverse
-- only expressions reached from statements in this function.
check_scoped_expr(
    dmap: DefMap,
    sink: ds.DiagnosticSink,
    kind_tags: list[int],
    left_ids: list[int],
    right_ids: list[int],
    third_ids: list[int],
    names: list[string],
    arg_starts: list[int],
    arg_counts: list[int],
    arg_ids: list[int],
    expr_id: int,
    visible_locals: list[string]
)
    if expr_id < 0 or expr_id >= lists.len(kind_tags)
        return
    end
    const tag = lists.get(kind_tags, expr_id)
    if tag == 4
        const name = lists.get(names, expr_id)
        match lookup_def_id(dmap, name)
        case some(def_id):
            if lists.get(dmap.kinds, def_id) == 6
                var found = false
                var local_idx = 0
                while local_idx < lists.len(visible_locals)
                    if name == lists.get(visible_locals, local_idx)
                        found = true
                    end
                    local_idx = local_idx + 1
                end
                if not found
                    ds.emit_error(sink, "name.undefined", "undefined identifier in this function: " + name, "declare the binding before use in the same function")
                end
            end
        case none:
        end
    elif tag == 5
        check_scoped_expr(dmap, sink, kind_tags, left_ids, right_ids, third_ids, names, arg_starts, arg_counts, arg_ids, lists.get(left_ids, expr_id), visible_locals)
        check_scoped_expr(dmap, sink, kind_tags, left_ids, right_ids, third_ids, names, arg_starts, arg_counts, arg_ids, lists.get(right_ids, expr_id), visible_locals)
    elif tag == 6
        const arg_start = lists.get(arg_starts, expr_id)
        var arg_idx = 0
        while arg_idx < lists.get(arg_counts, expr_id)
            check_scoped_expr(dmap, sink, kind_tags, left_ids, right_ids, third_ids, names, arg_starts, arg_counts, arg_ids, lists.get(arg_ids, arg_start + arg_idx), visible_locals)
            arg_idx = arg_idx + 1
        end
    elif tag == 11
        check_scoped_expr(dmap, sink, kind_tags, left_ids, right_ids, third_ids, names, arg_starts, arg_counts, arg_ids, lists.get(left_ids, expr_id), visible_locals)
        check_scoped_expr(dmap, sink, kind_tags, left_ids, right_ids, third_ids, names, arg_starts, arg_counts, arg_ids, lists.get(right_ids, expr_id), visible_locals)
        check_scoped_expr(dmap, sink, kind_tags, left_ids, right_ids, third_ids, names, arg_starts, arg_counts, arg_ids, lists.get(third_ids, expr_id), visible_locals)
    end
end

public check_function_scope(
    dmap: DefMap,
    sink: ds.DiagnosticSink,
    expr_kinds: list[int],
    expr_lefts: list[int],
    expr_rights: list[int],
    expr_thirds: list[int],
    expr_names: list[string],
    expr_arg_starts: list[int],
    expr_arg_counts: list[int],
    expr_arg_ids: list[int],
    stmt_kinds: list[int],
    stmt_exprs: list[int],
    stmt_names: list[string],
    stmt_branches: list[int],
    stmt_ends: list[int],
    first_stmt: int,
    last_stmt: int,
    param_names: list[string]
)
    const visible_locals: list[string] = []
    var param_idx = 0
    while param_idx < lists.len(param_names)
        lists.push(visible_locals, lists.get(param_names, param_idx))
        param_idx = param_idx + 1
    end
    check_scope_block(dmap, sink, expr_kinds, expr_lefts, expr_rights, expr_thirds, expr_names, expr_arg_starts, expr_arg_counts, expr_arg_ids, stmt_kinds, stmt_exprs, stmt_names, stmt_branches, stmt_ends, first_stmt, last_stmt, visible_locals)
end

copy_visible_names(names: list[string]) -> list[string]
    const copy: list[string] = []
    var j = 0
    while j < lists.len(names)
        lists.push(copy, lists.get(names, j))
        j = j + 1
    end
    return copy
end

check_scope_block(dmap: DefMap, sink: ds.DiagnosticSink, expr_kinds: list[int], expr_lefts: list[int], expr_rights: list[int], expr_thirds: list[int], expr_names: list[string], expr_arg_starts: list[int], expr_arg_counts: list[int], expr_arg_ids: list[int], stmt_kinds: list[int], stmt_exprs: list[int], stmt_names: list[string], stmt_branches: list[int], stmt_ends: list[int], first_stmt: int, last_stmt: int, visible_locals: list[string])
    var i = first_stmt
    while i < last_stmt
        check_scoped_expr(dmap, sink, expr_kinds, expr_lefts, expr_rights, expr_thirds, expr_names, expr_arg_starts, expr_arg_counts, expr_arg_ids, lists.get(stmt_exprs, i), visible_locals)
        const tag = lists.get(stmt_kinds, i)
        const subtree_end = lists.get(stmt_ends, i)
        if tag == 1
            lists.push(visible_locals, lists.get(stmt_names, i))
        elif tag == 4
            const else_start = lists.get(stmt_branches, i)
            check_scope_block(dmap, sink, expr_kinds, expr_lefts, expr_rights, expr_thirds, expr_names, expr_arg_starts, expr_arg_counts, expr_arg_ids, stmt_kinds, stmt_exprs, stmt_names, stmt_branches, stmt_ends, i + 1, else_start, copy_visible_names(visible_locals))
            check_scope_block(dmap, sink, expr_kinds, expr_lefts, expr_rights, expr_thirds, expr_names, expr_arg_starts, expr_arg_counts, expr_arg_ids, stmt_kinds, stmt_exprs, stmt_names, stmt_branches, stmt_ends, else_start, subtree_end, copy_visible_names(visible_locals))
        elif tag == 5
            check_scope_block(dmap, sink, expr_kinds, expr_lefts, expr_rights, expr_thirds, expr_names, expr_arg_starts, expr_arg_counts, expr_arg_ids, stmt_kinds, stmt_exprs, stmt_names, stmt_branches, stmt_ends, i + 1, subtree_end, copy_visible_names(visible_locals))
        elif tag == 9
            var arm = i + 1
            while arm < subtree_end
                if lists.get(stmt_kinds, arm) != 10
                    break
                end
                const pat_expr = lists.get(stmt_exprs, arm)
                if pat_expr >= 0
                    check_scoped_expr(dmap, sink, expr_kinds, expr_lefts, expr_rights, expr_thirds, expr_names, expr_arg_starts, expr_arg_counts, expr_arg_ids, pat_expr, visible_locals)
                end
                const arm_end = lists.get(stmt_ends, arm)
                if arm_end <= arm or arm_end > subtree_end
                    break
                end
                check_scope_block(dmap, sink, expr_kinds, expr_lefts, expr_rights, expr_thirds, expr_names, expr_arg_starts, expr_arg_counts, expr_arg_ids, stmt_kinds, stmt_exprs, stmt_names, stmt_branches, stmt_ends, arm + 1, arm_end, copy_visible_names(visible_locals))
                arm = arm_end
            end
        end
        if subtree_end <= i
            i = i + 1
        else
            i = subtree_end
        end
    end
end

is_builtin_or_primitive(name: string) -> bool
    if name == "int" or name == "string" or name == "bool" or name == "float" or name == "void"
        return true
    elif name == "list" or name == "result" or name == "optional" or name == "map" or name == "set"
        return true
    elif name == "println" or name == "print" or name == "ok" or name == "err" or name == "some" or name == "none"
        return true
    end
    return false
end

is_expr_noise(name: string) -> bool
    -- String literals and operator fragments should never be treated as identifier references:
    -- tags 2 (StrLit), noise fragments, numeric markers
    if su.len(name) == 0
        return true
    end
    if su.starts_with(name, "\"")
        return true
    end
    if su.starts_with(name, "f\"")
        return true
    end
    const first = su.slice(name, 0, 1)
    if first == "{" or first == "+" or first == "-" or first == "*" or first == "/"
        return true
    end
    return false
end

public pass1_collect_declarations_pub(
    dmap: DefMap,
    sink: ds.DiagnosticSink,
    module_name: string,
    func_names: list[string],
    func_is_pub: list[int],
    struct_names: list[string],
    struct_is_pub: list[int],
    enum_names: list[string],
    enum_is_pub: list[int]
)
    -- 1. Register Structs
    var s_idx = 0
    while s_idx < lists.len(struct_names)
        const sname = lists.get(struct_names, s_idx)
        const pub_flag = if s_idx < lists.len(struct_is_pub) and lists.get(struct_is_pub, s_idx) == 1 then true else false
        register_def(dmap, sink, sname, module_name + "." + sname, 1, pub_flag)
        s_idx = s_idx + 1
    end

    -- 2. Register Enums
    var e_idx = 0
    while e_idx < lists.len(enum_names)
        const ename = lists.get(enum_names, e_idx)
        const pub_flag = if e_idx < lists.len(enum_is_pub) and lists.get(enum_is_pub, e_idx) == 1 then true else false
        register_def(dmap, sink, ename, module_name + "." + ename, 2, pub_flag)
        e_idx = e_idx + 1
    end

    -- 3. Register Functions
    var f_idx = 0
    while f_idx < lists.len(func_names)
        const fname = lists.get(func_names, f_idx)
        const pub_flag = if f_idx < lists.len(func_is_pub) and lists.get(func_is_pub, f_idx) == 1 then true else false
        register_def(dmap, sink, fname, module_name + "." + fname, 4, pub_flag)
        f_idx = f_idx + 1
    end
end

public register_local_bindings(
    dmap: DefMap,
    names: list[string]
)
    var i = 0
    const total = lists.len(names)
    while i < total
        const lname = lists.get(names, i)
        if lname != "" and lname != "destructure"
            match lookup_def_id(dmap, lname)
            case some(_):
            case none:
                const id = lists.len(dmap.names)
                lists.push(dmap.names, lname)
                lists.push(dmap.paths, lname)
                lists.push(dmap.kinds, 6) -- Local var/const binding
                lists.push(dmap.is_public_flags, 0)
            end
        end
        i = i + 1
    end
end

public total_defs(dmap: DefMap) -> int
    return lists.len(dmap.names)
end

public is_def_public(dmap: DefMap, name: string) -> optional[bool]
    match lookup_def_id(dmap, name)
    case some(idx):
        return some(lists.get(dmap.is_public_flags, idx) == 1)
    case none:
        return none
    end
end

public check_cross_module_access(dmap: DefMap, sink: ds.DiagnosticSink, name: string)
    match lookup_def_id(dmap, name)
    case some(idx):
        if lists.get(dmap.is_public_flags, idx) == 0
            ds.emit_error(sink, "name.private", "item is private and cannot be accessed from another module", "declare it as public or keep usage within the owning module")
        end
    case none:
    end
end
